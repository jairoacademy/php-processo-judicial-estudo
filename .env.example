# Copie para .env (cp .env.example .env). O .env não vai para o git.

# Porta do nginx no host
APP_PORT=8090

# Banco da aplicação (MySQL do docker compose). Os testes usam o banco <DB_NAME>_test.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=processo
DB_USER=processo
DB_PASSWORD=processo

# Container do MySQL
MYSQL_DATABASE=processo
MYSQL_USER=processo
MYSQL_PASSWORD=processo
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
