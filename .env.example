# Copie para .env (cp .env.example .env). O .env não vai para o git.

# Porta do nginx no host
APP_PORT=8080

# Banco usado pela aplicação. Vazio = SQLite em data/estudo.sqlite.
# O esquema ainda é só SQLite; o MySQL entra na fase de migrations.
DB_DSN=
DB_USER=
DB_PASSWORD=

# Container do MySQL
MYSQL_DATABASE=processo
MYSQL_USER=processo
MYSQL_PASSWORD=processo
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
