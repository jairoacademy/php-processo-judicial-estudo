{
    "name": "jairoacademy/php-processo-judicial-estudo",
    "description": "Projeto de estudo em PHP 8 sobre o domínio de processo judicial eletrônico",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "doctrine/migrations": "^3.9",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "ProcessoJudicialEstudo\\": "src/",
            "ProcessoJudicialEstudo\\Migrations\\": "migrations/"
        },
        "files": [
            "src/Web/funcoes.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ProcessoJudicialEstudo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@db:test:prepare",
            "phpunit"
        ],
        "test:unit": "phpunit --testsuite unit",
        "test:integration": [
            "@db:test:prepare",
            "phpunit --testsuite integration"
        ],
        "db:migrate": "doctrine-migrations migrate --no-interaction --allow-no-migration",
        "db:status": "doctrine-migrations status",
        "db:rollback": "doctrine-migrations migrate prev --no-interaction",
        "db:test:prepare": [
            "@putenv DB_NAME=processo_test",
            "doctrine-migrations migrate --no-interaction --allow-no-migration --quiet"
        ],
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "scripts-descriptions": {
        "test": "Roda todas as suítes do PHPUnit",
        "stan": "Análise estática com PHPStan no nível máximo",
        "cs": "Verifica o estilo de código (PER-CS) sem alterar arquivos",
        "cs:fix": "Corrige o estilo de código",
        "check": "Estilo, análise estática e testes: o mesmo que o CI roda",
        "db:migrate": "Aplica as migrations pendentes no banco de desenvolvimento",
        "db:status": "Mostra as migrations aplicadas e pendentes",
        "db:rollback": "Desfaz a última migration aplicada",
        "db:test:prepare": "Aplica as migrations no banco de testes (processo_test)"
    }
}
